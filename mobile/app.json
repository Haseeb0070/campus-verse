{
  "expo": {
    "name": "CampusVerse",
    "slug": "campusverse",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "campusverse",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#eef2f6",
    "ios": {
      "bundleIdentifier": "pk.campusverse.app",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "pk.campusverse.app",
      "adaptiveIcon": {
        "backgroundColor": "#2f6fae",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": true,
      "versionCode": 7,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "campus-verse-flame.vercel.app",
              "pathPrefix": "/today"
            },
            {
              "scheme": "https",
              "host": "campus-verse-flame.vercel.app",
              "pathPrefix": "/timetable"
            },
            {
              "scheme": "https",
              "host": "campus-verse-flame.vercel.app",
              "pathPrefix": "/chat"
            },
            {
              "scheme": "https",
              "host": "campus-verse-flame.vercel.app",
              "pathPrefix": "/notices"
            },
            {
              "scheme": "https",
              "host": "campus-verse-flame.vercel.app",
              "pathPrefix": "/assignments"
            },
            {
              "scheme": "https",
              "host": "campus-verse-flame.vercel.app",
              "pathPrefix": "/calendar"
            },
            {
              "scheme": "https",
              "host": "campus-verse-flame.vercel.app",
              "pathPrefix": "/feed"
            },
            {
              "scheme": "https",
              "host": "campus-verse-flame.vercel.app",
              "pathPrefix": "/resources"
            },
            {
              "scheme": "https",
              "host": "campus-verse-flame.vercel.app",
              "pathPrefix": "/progress"
            },
            {
              "scheme": "https",
              "host": "campus-verse-flame.vercel.app",
              "pathPrefix": "/notifications"
            },
            {
              "scheme": "https",
              "host": "campus-verse-flame.vercel.app",
              "pathPrefix": "/profile"
            },
            {
              "scheme": "https",
              "host": "campus-verse-flame.vercel.app",
              "pathPrefix": "/requests"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2f6fae",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-font",
      "./plugins/with-short-native-paths",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      "./plugins/with-release-signing",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ],
            "useLegacyPackaging": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2f6fae"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "expo-navigation-bar": {
        "enforceContrast": false
      },
      "eas": {
        "projectId": "30df9309-ffa9-4295-b2f4-242d8b7b5889"
      }
    },
    "owner": "haseeb0078"
  }
}
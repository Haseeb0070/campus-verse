{
  "http_server": {
    "port": 8001
  },
  "client": {
    "token": {
      "hmac_secret_key": "dev-centrifugo-token-secret-change-me-0123456789"
    },
    "allowed_origins": ["http://localhost:3000"]
  },
  "http_api": {
    "key": "dev-centrifugo-api-key"
  },
  "admin": {
    "enabled": true,
    "password": "dev-admin-password",
    "secret": "dev-admin-secret"
  },
  "channel": {
    "namespaces": [
      {
        "name": "chat",
        "presence": true,
        "allow_presence_for_subscriber": true,
        "history_size": 100,
        "history_ttl": "600s",
        "force_recovery": true
      },
      {
        "name": "typing",
        "allow_publish_for_subscriber": true
      },
      {
        "name": "user",
        "allow_user_limited_channels": true,
        "history_size": 20,
        "history_ttl": "300s",
        "force_recovery": true
      }
    ]
  }
}

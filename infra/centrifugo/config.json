{
  "client": {
    "token": {
      "hmac_secret_key": "dev-centrifugo-token-secret"
    },
    "allowed_origins": ["http://localhost:3000"]
  },
  "http_api": {
    "key": "dev-centrifugo-api-key"
  },
  "admin": {
    "enabled": true,
    "password": "dev-admin-password",
    "secret": "dev-admin-secret"
  },
  "channel": {
    "namespaces": [
      {
        "name": "chat",
        "presence": true,
        "join_leave": true,
        "force_push_join_leave": true,

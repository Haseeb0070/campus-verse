    { "id": "hook", "start": 0, "end": 8.94, "verse": "happy", "line": "Hi, I'm Jerry! Five WhatsApp groups, missed notices, and finding it hard to know which lecture is on right now? Let's fix that." },
    { "id": "today", "start": 8.94, "end": 17.29, "verse": "proud", "bg": "navy", "kicker": "For students", "title": "Today, on the first screen", "line": "Meet CampusVerse. Open it and Today shows your next class and room, your latest chats, due work and new notices, all on the first screen." },
    { "id": "chat", "start": 17.29, "end": 26.29, "verse": "happy", "bg": "cream", "kicker": "For students", "title": "A chat for every subject", "line": "Every subject has its own chat, with your teacher right inside it. Ask a question, get an answer. You can also message classmates privately." },
    { "id": "work", "start": 26.29, "end": 32.69, "verse": "approving", "bg": "navy", "kicker": "For students", "title": "Assignments and progress", "line": "Hand in assignments online before the deadline, and check your marks and attendance for every subject, anytime." },
    { "id": "teachers", "start": 32.69, "end": 39.64, "verse": "proud", "bg": "blue", "kicker": "For teachers", "title": "Run the class from a phone", "line": "Teachers can pin important notices, move or cancel a class in one step, and mark attendance right from their phone." },

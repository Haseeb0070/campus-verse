    { "id": "hook", "start": 0, "end": 8.91, "verse": "happy", "line": "Hi, I'm Jerry! Five WhatsApp groups, missed notices, and finding it hard to know which lecture is on right now? Let's fix that." },
    { "id": "today", "start": 8.91, "end": 17.23, "verse": "proud", "bg": "navy", "kicker": "For students", "title": "Today, on the first screen", "line": "Meet CampusVerse. Open it and Today shows your next class and room, your latest chats, due work and new notices, all on the first screen." },
    { "id": "timetable", "start": 17.23, "end": 25.47, "verse": "curious", "bg": "blue", "kicker": "For students", "title": "Your whole week", "line": "Your whole week, in order. And when a class moves, your timetable updates instantly, with a notification so you're never in the wrong room." },
    { "id": "chat", "start": 25.47, "end": 34.44, "verse": "happy", "bg": "cream", "kicker": "For students", "title": "A chat for every subject", "line": "Every subject has its own chat, with your teacher right inside it. Ask a question, get an answer. You can also message classmates privately." },
    { "id": "work", "start": 34.44, "end": 40.81, "verse": "approving", "bg": "navy", "kicker": "For students", "title": "Assignments and progress", "line": "Hand in assignments online before the deadline, and check your marks and attendance for every subject, anytime." },
    { "id": "teachers", "start": 40.81, "end": 47.73, "verse": "proud", "bg": "blue", "kicker": "For teachers", "title": "Run the class from a phone", "line": "Teachers can pin important notices, move or cancel a class in one step, and mark attendance right from their phone." },
    { "id": "office", "start": 47.73, "end": 54.7, "verse": "curious", "bg": "cream", "kicker": "For the college office", "title": "Accounts and the timetable", "line": "The college office sets up accounts by roll number and imports the timetable, checking every change before it goes out." },
    { "id": "close", "start": 54.7, "end": 60.1, "verse": "excited", "bg": "navy", "kicker": "Get started", "title": "Sign in and go", "line": "Use it in any browser, or on the Android app. Just sign in with your roll number email." },
    { "id": "end", "start": 60.1, "end": 66, "verse": "happy", "bg": "navy", "line": "See you in R-127!", "say": "CampusVerse. Your college, on one screen. See you in R one twenty-seven!", "wordmark": "CampusVerse", "tagline": "Your college, on one screen.", "url": "campus-verse-flame.vercel.app" }
  ],

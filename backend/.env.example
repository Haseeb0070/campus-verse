# Copy to .env for local development. Never commit .env.
DEBUG=true
SECRET_KEY=dev-only-change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_URL unset to use SQLite (handy without Docker).
# With `docker compose up -d` in infra/, use Postgres:
# DATABASE_URL=postgres://campusverse:campusverse@localhost:5432/campusverse
# REDIS_URL=redis://localhost:6379/0

FRONTEND_URL=http://localhost:3000
TIME_ZONE=UTC

# Accounts are created by invite or import. Keep public sign-up closed.
OPEN_SIGNUP=false

# Mailpit from infra/docker-compose.yml (web inbox on :8025). Without Docker, use
# EMAIL_URL=consolemail:// to print emails (including invite links) in the server log.
EMAIL_URL=smtp://localhost:1025

CENTRIFUGO_API_URL=http://localhost:8001/api
CENTRIFUGO_API_KEY=dev-centrifugo-api-key
CENTRIFUGO_TOKEN_SECRET=dev-centrifugo-token-secret-change-me-0123456789
CENTRIFUGO_WS_URL=ws://localhost:8001/connection/websocket
